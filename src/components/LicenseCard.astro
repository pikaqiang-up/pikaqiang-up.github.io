---
import siteConfig from '~/site.config'

interface Props {
  title: string
  url: string
  author?: string
  published: Date
}

const { title, url, author = siteConfig.author, published } = Astro.props

const licenseUrl = 'https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh-hans'
const licenseName = 'CC BY-NC-SA 4.0'

const d = new Date(published)
const dateText = `${d.getUTCFullYear()} 年 ${d.getUTCMonth() + 1} 月 ${d.getUTCDate()} 日`
---

<div
  class="relative overflow-hidden max-w-full mb-6 rounded-xl border border-foreground/10 bg-foreground/5 px-5 py-5 sm:px-6 sm:py-6"
>
  <div class="relative z-10">
    <div class="text-base font-semibold sm:text-lg">{title}</div>
    <a
      href={url}
      class="mt-1.5 block text-sm break-all text-foreground/60 hover:text-link">{url}</a
    >

    <div class="mt-4 flex flex-wrap gap-x-10 gap-y-3">
      <div>
        <div class="text-xs text-foreground/60">本文作者</div>
        <div class="mt-0.5">{author}</div>
      </div>
      <div>
        <div class="text-xs text-foreground/60">发布于</div>
        <div class="mt-0.5">{dateText}</div>
      </div>
      <div>
        <div class="text-xs text-foreground/60">许可协议</div>
        <div class="mt-0.5">
          <a
            href={licenseUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-link underline underline-offset-2">{licenseName}</a
          >
        </div>
      </div>
    </div>

    <div class="mt-4 border-t border-foreground/10 pt-4 text-sm text-foreground/70">
      转载或引用本文时请遵守许可协议，注明出处，不得用于商业用途，并以相同方式共享。
    </div>
  </div>

  <svg
    class="pointer-events-none absolute -right-3 -bottom-3 size-28 text-foreground/10"
    viewBox="0 0 48 48"
    fill="none"
    aria-hidden="true"
  >
    <circle cx="24" cy="24" r="23" stroke="currentColor" stroke-width="2.5"></circle>
    <text
      x="24"
      y="31.5"
      text-anchor="middle"
      font-size="19"
      font-weight="700"
      fill="currentColor">CC</text
    >
  </svg>
</div>
