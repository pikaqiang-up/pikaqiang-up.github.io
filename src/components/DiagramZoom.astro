---
// Click-to-zoom overlay for rendered mermaid diagrams.
// Independent of astro-mermaid: it clones the current <svg> when clicked, so the
// active (theme-aware) colors are carried into the overlay.
---

<div class="diagram-zoom" data-diagram-zoom hidden aria-hidden="true">
  <div class="diagram-zoom__toolbar">
    <button type="button" data-zoom-out aria-label="缩小" title="缩小">−</button>
    <button type="button" data-zoom-reset aria-label="重置" title="重置">⟲</button>
    <button type="button" data-zoom-in aria-label="放大" title="放大">＋</button>
    <button type="button" data-zoom-close aria-label="关闭" title="关闭 (Esc)">✕</button>
  </div>
  <div class="diagram-zoom__viewport" data-zoom-viewport>
    <div class="diagram-zoom__stage" data-zoom-stage></div>
  </div>
</div>

<style is:global>
  .mermaid svg {
    cursor: zoom-in;
  }

  .diagram-zoom {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--theme-background) 86%, transparent);
    backdrop-filter: blur(6px);
  }

  .diagram-zoom[hidden] {
    display: none !important;
  }

  .diagram-zoom__toolbar {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 2;
    display: flex;
    gap: 0.5rem;
  }

  .diagram-zoom__toolbar button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid color-mix(in srgb, var(--theme-foreground) 25%, transparent);
    border-radius: 0.6rem;
    background: color-mix(
      in srgb,
      var(--theme-background) 80%,
      var(--theme-foreground) 20%
    );
    color: var(--theme-foreground);
    font-size: 1.15rem;
    line-height: 1;
    cursor: pointer;
    transition:
      color 0.15s,
      border-color 0.15s;
  }

  .diagram-zoom__toolbar button:hover {
    color: var(--theme-accent);
    border-color: var(--theme-accent);
  }

  .diagram-zoom__viewport {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    cursor: grab;
    touch-action: none;
    overscroll-behavior: contain;
    -webkit-user-select: none;
    user-select: none;
  }

  .diagram-zoom__viewport.is-dragging {
    cursor: grabbing;
  }

  .diagram-zoom__stage {
    transform-origin: center center;
    will-change: transform;
  }

  .diagram-zoom__stage svg {
    display: block;
    max-width: none !important;
    height: auto;
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>('[data-diagram-zoom]')
  const viewport = document.querySelector<HTMLElement>('[data-zoom-viewport]')
  const stage = document.querySelector<HTMLElement>('[data-zoom-stage]')

  if (overlay && viewport && stage) {
    const MIN_SCALE = 0.1
    const MAX_SCALE = 8

    let scale = 1
    let tx = 0
    let ty = 0
    let fitScale = 1
    let isOpen = false
    let prevOverflow = ''

    const clamp = (v: number, min: number, max: number) => Math.min(Math.max(v, min), max)

    const apply = () => {
      stage.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`
    }

    const svgSize = (svg: SVGSVGElement) => {
      const vb = svg.viewBox?.baseVal
      if (vb && vb.width && vb.height) return { w: vb.width, h: vb.height }
      const rect = svg.getBoundingClientRect()
      return { w: rect.width || 800, h: rect.height || 600 }
    }

    const open = (svg: SVGSVGElement) => {
      const { w, h } = svgSize(svg)
      const clone = svg.cloneNode(true) as SVGSVGElement
      clone.removeAttribute('style')
      clone.setAttribute('width', String(w))
      clone.setAttribute('height', String(h))
      clone.style.width = `${w}px`
      clone.style.height = `${h}px`
      clone.style.maxWidth = 'none'

      stage.replaceChildren(clone)

      const vw = viewport.clientWidth || window.innerWidth
      const vh = viewport.clientHeight || window.innerHeight
      fitScale = clamp(Math.min((vw * 0.9) / w, (vh * 0.85) / h), MIN_SCALE, 2.5)
      scale = fitScale
      tx = 0
      ty = 0
      apply()

      prevOverflow = document.documentElement.style.overflow
      document.documentElement.style.overflow = 'hidden'
      overlay.hidden = false
      overlay.setAttribute('aria-hidden', 'false')
      isOpen = true
      overlay.querySelector<HTMLButtonElement>('[data-zoom-close]')?.focus()
    }

    const close = () => {
      if (!isOpen) return
      isOpen = false
      overlay.hidden = true
      overlay.setAttribute('aria-hidden', 'true')
      stage.replaceChildren()
      document.documentElement.style.overflow = prevOverflow
    }

    const zoomAt = (px: number, py: number, factor: number) => {
      const next = clamp(scale * factor, MIN_SCALE, MAX_SCALE)
      if (next === scale) return
      tx = px - (next / scale) * (px - tx)
      ty = py - (next / scale) * (py - ty)
      scale = next
      apply()
    }

    // Open on click of a rendered diagram (event delegation).
    document.addEventListener('click', (event) => {
      const target = event.target as Element | null
      const svg = target?.closest?.('.mermaid svg') as SVGSVGElement | null
      if (!svg) return
      event.preventDefault()
      open(svg)
    })

    // Toolbar
    overlay.querySelector('[data-zoom-in]')?.addEventListener('click', () => {
      zoomAt(viewport.clientWidth / 2, viewport.clientHeight / 2, 1.25)
    })
    overlay.querySelector('[data-zoom-out]')?.addEventListener('click', () => {
      zoomAt(viewport.clientWidth / 2, viewport.clientHeight / 2, 1 / 1.25)
    })
    overlay.querySelector('[data-zoom-reset]')?.addEventListener('click', () => {
      scale = fitScale
      tx = 0
      ty = 0
      apply()
    })
    overlay.querySelector('[data-zoom-close]')?.addEventListener('click', close)

    // Wheel zoom centered on the cursor
    viewport.addEventListener(
      'wheel',
      (event) => {
        event.preventDefault()
        const rect = viewport.getBoundingClientRect()
        const px = event.clientX - rect.left - rect.width / 2
        const py = event.clientY - rect.top - rect.height / 2
        zoomAt(px, py, event.deltaY < 0 ? 1.1 : 1 / 1.1)
      },
      { passive: false },
    )

    // Pointer gestures: one finger / mouse drags to pan, two fingers pinch to zoom.
    type PointerPos = { x: number; y: number }

    const pointers = new Map<number, PointerPos>()

    let mode: 'none' | 'drag' | 'pinch' = 'none'
    let moved = false
    let suppressClickUntil = 0

    let dragStartX = 0
    let dragStartY = 0
    let dragStartTx = 0
    let dragStartTy = 0

    let pinchStartDistance = 0
    let pinchStartMidX = 0
    let pinchStartMidY = 0
    let pinchStartScale = 1
    let pinchStartTx = 0
    let pinchStartTy = 0

    const centerOf = (a: PointerPos, b: PointerPos): PointerPos => ({
      x: (a.x + b.x) / 2,
      y: (a.y + b.y) / 2,
    })

    const distanceOf = (a: PointerPos, b: PointerPos) => Math.hypot(a.x - b.x, a.y - b.y)

    // Position relative to the viewport center, which is the coordinate space used by `zoomAt`.
    const toCenter = (p: PointerPos): PointerPos => {
      const rect = viewport.getBoundingClientRect()
      return { x: p.x - rect.left - rect.width / 2, y: p.y - rect.top - rect.height / 2 }
    }

    const beginDrag = (p: PointerPos) => {
      mode = 'drag'
      dragStartX = p.x
      dragStartY = p.y
      dragStartTx = tx
      dragStartTy = ty
      viewport.classList.add('is-dragging')
    }

    const beginPinch = () => {
      const [a, b] = [...pointers.values()]
      if (!a || !b) return
      const mid = toCenter(centerOf(a, b))
      pinchStartDistance = distanceOf(a, b)
      pinchStartMidX = mid.x
      pinchStartMidY = mid.y
      pinchStartScale = scale
      pinchStartTx = tx
      pinchStartTy = ty
      mode = 'pinch'
      viewport.classList.add('is-dragging')
    }

    viewport.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse' && event.button !== 0) return
      try {
        viewport.setPointerCapture(event.pointerId)
      } catch {
        /* ignore */
      }
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY })

      if (pointers.size === 1) {
        moved = false
        beginDrag({ x: event.clientX, y: event.clientY })
      } else if (pointers.size === 2) {
        beginPinch()
      }
    })

    viewport.addEventListener('pointermove', (event) => {
      if (!pointers.has(event.pointerId)) return
      const p = { x: event.clientX, y: event.clientY }
      pointers.set(event.pointerId, p)

      if (pointers.size >= 2 && mode === 'pinch') {
        const [a, b] = [...pointers.values()]
        if (!a || !b || pinchStartDistance === 0) return

        const nextScale = clamp(
          pinchStartScale * (distanceOf(a, b) / pinchStartDistance),
          MIN_SCALE,
          MAX_SCALE,
        )
        const ratio = nextScale / pinchStartScale
        const mid = toCenter(centerOf(a, b))

        // Keep the content under the initial midpoint glued to the current midpoint.
        tx = mid.x - ratio * (pinchStartMidX - pinchStartTx)
        ty = mid.y - ratio * (pinchStartMidY - pinchStartTy)
        scale = nextScale
        moved = true
        apply()
      } else if (pointers.size === 1 && mode === 'drag') {
        const dx = p.x - dragStartX
        const dy = p.y - dragStartY
        if (Math.abs(dx) + Math.abs(dy) > 4) moved = true
        tx = dragStartTx + dx
        ty = dragStartTy + dy
        apply()
      }
    })

    const endPointer = (event: PointerEvent) => {
      pointers.delete(event.pointerId)
      try {
        viewport.releasePointerCapture(event.pointerId)
      } catch {
        /* ignore */
      }

      if (moved) suppressClickUntil = performance.now() + 400

      if (pointers.size === 1) {
        // A finger was lifted mid-pinch: continue with a one-finger drag.
        const [remaining] = [...pointers.values()]
        if (remaining) beginDrag(remaining)
      } else if (pointers.size === 0) {
        mode = 'none'
        viewport.classList.remove('is-dragging')
      }
    }
    viewport.addEventListener('pointerup', endPointer)
    viewport.addEventListener('pointercancel', endPointer)

    // Click the empty backdrop (but not the diagram / toolbar) to close.
    // Ignore the synthetic click that follows a pan/pinch gesture.
    overlay.addEventListener('click', (event) => {
      if (performance.now() < suppressClickUntil) return
      const el = event.target as Element | null
      if (el?.closest('.diagram-zoom__toolbar')) return
      if (el?.closest('.diagram-zoom__stage')) return
      close()
    })

    // Esc to close
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen) close()
    })
  }
</script>
